# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
# NUNCA subas .env.local al repositorio.

# URL del proyecto (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable (sb_publishable_...) o, en proyectos antiguos, la clave "anon".
# Es pública por diseño: la seguridad la garantiza Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública de la aplicación (se usa en enlaces de correo de Supabase Auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Entorno en ejecución: local, preview, staging o production (docs/CI_CD.md).
# Lo muestra /api/salud y lo llevan los registros de arranque. Vacío = local.
APP_ENV=

# Clave secreta (sb_secret_... o service_role). SOLO SERVIDOR, nunca con prefijo
# NEXT_PUBLIC_. Se usa únicamente para invitar personas a Supabase Auth y
# localizar su cuenta por correo (ADR-025). Sin ella, el resto funciona y las
# invitaciones muestran un aviso. Guárdala en el gestor de secretos del hosting.
SUPABASE_SECRET_KEY=

# Lectura automática de tickets (OCR). Vacío = sin OCR: los gastos se completan a
# mano y ningún ticket sale de la plataforma. "fake" activa un lector sintético
# determinista SOLO fuera de producción (desarrollo y pruebas). Un proveedor real
# exige antes un ADR, contrato de encargo de tratamiento y credenciales (docs/GASTOS.md).
OCR_PROVIDER=

# Tareas programadas (docs/AVISOS.md): secreto que el planificador envía como
# "Authorization: Bearer <CRON_SECRET>" a /api/tareas. Mínimo 32 caracteres
# aleatorios. Sin él, las tareas no se ejecutan. Requiere SUPABASE_SECRET_KEY.
CRON_SECRET=

# Correo. Vacío = sin correo (los avisos llegan solo a la bandeja). "fake" solo
# fuera de producción. Un proveedor real exige ADR, dominio verificado y
# credenciales (guía en docs/AVISOS.md). No uses dominios de ejemplo.
EMAIL_PROVIDER=
EMAIL_FROM=
# Secreto para verificar la firma de los webhooks de entrega.
EMAIL_WEBHOOK_SECRET=

# Retención (docs/PRIVACIDAD.md). Vacío o "simulate" = la tarea programada solo
# calcula qué se borraría (recuentos en el registro). "execute" la aplica, y solo
# debe activarse tras validar la matriz con la organización.
RETENTION_MODE=

# Métricas operativas (docs/OBSERVABILIDAD.md): secreto que la monitorización envía
# como "Authorization: Bearer <METRICS_TOKEN>" a /api/salud/metricas. Mínimo 32
# caracteres aleatorios y distinto de CRON_SECRET. Vacío = métricas desactivadas.
METRICS_TOKEN=

# Nivel mínimo del registro técnico: debug, info (por defecto), warn o error.
# El registro nunca incluye datos personales ni secretos (src/lib/log.ts).
LOG_LEVEL=
