# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase.
# NUNCA subas .env.local al repositorio.

# URL del proyecto (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable (sb_publishable_...) o, en proyectos antiguos, la clave "anon".
# Es pública por diseño: la seguridad la garantiza Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública de la aplicación (se usa en enlaces de correo de Supabase Auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# La clave secreta / service_role NO se usa en la fase base.
# Si un módulo futuro la necesita, irá solo en variables de servidor sin prefijo
# NEXT_PUBLIC_ y se documentará en docs/DECISIONES.md.
# SUPABASE_SECRET_KEY=
